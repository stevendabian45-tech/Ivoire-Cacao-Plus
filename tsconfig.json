{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noImplicitAny": true,
    "noEmitOnError": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "index.ts",
    "modele/**/*.ts",
    "metier/**/*.ts",
    "donnees/**/*.ts",
    "interface/**/*.ts",
    "doublures/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
